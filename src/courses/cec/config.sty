\newcommand\Probleme[3]{
  \begin{center}
    \begin{minipage}{14cm}
      \begin{problembox}
        \textsc{#1}
        \begin{description}
        \item[Instance :]#2
        \item[Question :]#3
        \end{description}
      \end{problembox}
    \end{minipage}
  \end{center}
}

\newcommand\Minibox[1]{
  \begin{center}
    \begin{minipage}{14cm}
      \begin{problembox}
        #1
      \end{problembox}
    \end{minipage}
  \end{center}
}

